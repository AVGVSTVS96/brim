#!/bin/sh
# Runs on the Mac before a build: gives the build its own number, copies the app's name and version from project.yml
# to the extension's manifest, and makes the Xcode project. Safari keeps running an extension's old scripts until its
# version changes, so every build needs a new one.
set -e
cd "$(dirname "$0")/.."
build=$(( ($(date +%s) - 1794000000) / 60 ))
setting() { /usr/bin/sed -n "s/^ *$1: *\"*\([^\"]*\)\"*$/\1/p" project.yml | head -1; }
name=$(setting APP_NAME) version=$(setting MARKETING_VERSION)
/usr/bin/sed -i '' -e "s/\"name\": \".*\"/\"name\": \"$name\"/" -e "s/\"version\": \".*\"/\"version\": \"$version.$build\"/" \
  Extension/Resources/manifest.json
/usr/bin/sed -i '' "s/CURRENT_PROJECT_VERSION: .*/CURRENT_PROJECT_VERSION: \"$build\"/" project.yml
/opt/homebrew/bin/xcodegen generate -q
echo "$build"
