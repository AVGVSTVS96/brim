#!/bin/sh
# Builds Brim on the Mac (`ssh mac`, which has Xcode and the signing team) and installs it on an iPhone the Mac reaches.
# Usage: scripts/phone [device]   (a UDID or name; default: the first physical iPhone the Mac reaches)
set -e
cd "$(dirname "$0")/.."
rsync -a --delete --exclude .git --exclude build --exclude shots --exclude node_modules ./ mac:Developer/brim-build/
ssh mac sh -s "${1:-}" <<'MAC'
set -e
cd ~/Developer/brim-build
phone=$1
if [ -z "$phone" ]; then
  xcrun devicectl list devices --json-output /tmp/brim-devices.json >/dev/null
  phone=$(/usr/bin/python3 -c "
import json
for d in json.load(open('/tmp/brim-devices.json'))['result']['devices']:
    h, c = d['hardwareProperties'], d['connectionProperties']
    if h.get('deviceType') == 'iPhone' and h.get('reality') == 'physical' and c.get('transportType'): print(h['udid']); break")
fi
[ -n "$phone" ] || { echo "the Mac doesn't reach an iPhone" >&2; exit 1; }
echo "build $(scripts/version)"
scripts/gui xcodebuild build -project Brim.xcodeproj -scheme Brim -destination generic/platform=iOS -configuration Release \
  -derivedDataPath build -allowProvisioningUpdates -quiet
xcrun devicectl device install app --device "$phone" build/Build/Products/Release-iphoneos/Brim.app | grep -i bundleID
MAC
