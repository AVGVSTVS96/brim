{
  "manifest_version": 3,
  "name": "Span",
  "version": "1.0.0",
  "description": "Full-width web pages on the iPhone Duo's front screen, with text and buttons kept clear of Safari's column.",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
