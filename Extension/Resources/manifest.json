{
  "manifest_version": 3,
  "name": "Span",
  "version": "1.0.0",
  "description": "Lays web pages out across the whole front screen of iPhone Duo, keeping text and buttons clear of Safari's column.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
